{
  "title": "Vacuula",
  "config": {
    "step": {
      "user": {
        "title": "Connect to Vacuula",
        "description": "No new Vacuula server was found automatically. Enter the address of the existing server. All registered robots will be added automatically. Setup only reads robot data.",
        "data": {
          "url": "Server URL"
        },
        "data_description": {
          "url": "The HTTP or HTTPS address and app port. Use the app's direct address, without /web or an ingress path."
        }
      },
      "select_server": {
        "title": "Choose a Vacuula server",
        "description": "Several local Vacuula servers were found. Choose the server to connect.",
        "data": {
          "url": "Server"
        },
        "data_description": {
          "url": "Servers discovered on the local network, including their advertised ports."
        }
      },
      "confirm": {
        "title": "Vacuula server discovered",
        "description": "Connect Home Assistant to the local Vacuula server at {server} and add its robots?"
      },
      "reconfigure": {
        "title": "Change Vacuula server address",
        "description": "Enter the new address of the same server. Existing entity identities will be kept.",
        "data": {
          "url": "Server URL"
        }
      }
    },
    "error": {
      "cannot_connect": "Unable to connect to Vacuula. Check that the app is running and its direct HTTP port is accessible.",
      "invalid_url": "Enter an HTTP or HTTPS address with a port if needed, without a path, credentials or query parameters.",
      "wrong_server": "This server contains different robots. Add it as another integration instead."
    },
    "abort": {
      "already_configured": "This server or one of its robots is already configured.",
      "cannot_connect": "Unable to connect to the discovered Vacuula server.",
      "reconfigure_successful": "Vacuula server address updated."
    }
  },
  "exceptions": {
